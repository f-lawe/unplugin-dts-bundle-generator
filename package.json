{
  "name": "unplugin-dts-bundle-generator",
  "version": "3.4.3",
  "description": "DTS bundle generator for Unplugin",
  "keywords": [
    "unplugin",
    "esbuild",
    "rolldown",
    "rollup",
    "vite",
    "dts",
    "bundle",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f-lawe/unplugin-dts-bundle-generator.git"
  },
  "license": "MIT",
  "author": "François Lavaud-Wernert <francois@lavaud.family>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/dts-bundle-generator.d.ts",
      "import": "./dist/dts-bundle-generator.es.js",
      "require": "./dist/dts-bundle-generator.cjs.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.es.js",
      "require": "./dist/esbuild.cjs.js"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.ts",
      "import": "./dist/rolldown.es.js",
      "require": "./dist/rolldown.cjs.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "import": "./dist/rollup.es.js",
      "require": "./dist/rollup.cjs.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.es.js",
      "require": "./dist/vite.cjs.js"
    }
  },
  "main": "dist/dts-bundle-generator.cjs",
  "module": "dist/dts-bundle-generator.mjs",
  "source": "src/index.ts",
  "types": "dist/dts-bundle-generator.d.ts",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist",
    "lint": "eslint . --fix && sort-package-json",
    "lint:ci": "eslint . && sort-package-json --check",
    "prepack": "npm run clean && npm run build",
    "test": "npm run build && rimraf -v dist-esbuild dist-rolldown dist-rollup && node ./tests/esbuild.config.ts && rolldown --config ./tests/rollup.config.ts && rollup --config ./tests/rollup.config.ts",
    "test:esbuild": "npm run build && rimraf dist-esbuild && node ./tests/esbuild.config.ts",
    "test:rolldown": "npm run build & rimraf dist-rollup & rolldown --config ./tests/rollup.config.ts",
    "test:rollup": "npm run build & rimraf dist-rollup & rollup --config ./tests/rollup.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsc --noEmit",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "dts-bundle-generator": "^9.3.1",
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@nuxt/kit": "^4.3.1",
    "@nuxt/schema": "^4.3.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.2",
    "jiti": "^2.4.2",
    "rimraf": "^6.0.1",
    "rolldown": "^1.0.0-beta.32",
    "rollup": "^4.41.0",
    "sort-package-json": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "vite": "^7.0.0"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3 || ^4",
    "@nuxt/schema": "^3 || ^4",
    "esbuild": "*",
    "rollup": ">=4",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
